# Required to use /admin. Without a password and secret, /admin shows a setup notice and the API refuses all calls.
# Login name for /admin (optional, defaults to "admin")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 16+ random characters; signs the admin session cookie. CHANGE THIS before deploying. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional
# Public origin used for canonical URLs / sitemap / social cards (overrides the value saved in the admin):
# SITE_URL=https://example.com
# Where site.json, uploads/ and backups/ live (point this at a persistent volume in production):
# CONTENT_DIR=/data/content
