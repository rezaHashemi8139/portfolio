# Required to use /admin. Without them /admin shows a setup notice and the API refuses all calls.
ADMIN_PASSWORD=change-me
# 16+ random characters; signs the admin session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional
# Public origin used for canonical URLs / sitemap / social cards (overrides the value saved in the admin):
# SITE_URL=https://example.com
# Where site.json, uploads/ and backups/ live (point this at a persistent volume in production):
# CONTENT_DIR=/data/content
